APP_NAME=Tarik
NODE_ENV=development
PORT=5000

DATABASE_URL=mongodb://localhost:27017/tarik_db
DB_MAX_POOL_SIZE=10

BCRYPT_SALT_ROUNDS=8
ADMIN_SECRET_KEY=your_admin_secret_key_here

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_IN=30d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRE_IN=30d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_PREFIX=tarik
CACHE_USER_PROFILE_TTL_SECONDS=300

RESEND_API_KEY=re_your_resend_api_key_here
MAIL_DOMAIN=noreply@yourdomain.com

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tarik-app-bucket

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Firebase Cloud Messaging (server) — from Google Cloud service account JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Optional extras from the same service account file
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

SOCKET_ENABLED=true
SOCKET_CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=tarik-uploads
MINIO_USE_SSL=false
MINIO_BASE_URL=http://localhost:9000

ADMIN_SEED_EMAIL=admin@tarik.com
ADMIN_SEED_PASSWORD=Admin123!

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
