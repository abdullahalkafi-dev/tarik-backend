APP_NAME=Tarik
NODE_ENV=development
PORT=5000

DATABASE_URL=mongodb://localhost:27017/tarik_db
DB_MAX_POOL_SIZE=10

BCRYPT_SALT_ROUNDS=8
ADMIN_SECRET_KEY=your_admin_secret_key_here

JWT_SECRET=your_jwt_secret_key_here
# Access token lifetime. The apps renew it silently with the refresh token (sessions can be revoked server-side).
JWT_EXPIRE_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRE_IN=30d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_PREFIX=tarik
CACHE_USER_PROFILE_TTL_SECONDS=300

# Firebase Cloud Messaging (server) — from Google Cloud service account JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Optional extras from the same service account file
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

SOCKET_ENABLED=true
SOCKET_CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
# true in production: browsers from origins that are not in CORS_ORIGIN are rejected
CORS_STRICT=false

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=tarik-uploads
MINIO_USE_SSL=false
MINIO_BASE_URL=http://localhost:9000

ADMIN_SEED_EMAIL=admin@tarik.com
ADMIN_SEED_PASSWORD=Admin123!

FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# HERE Map (geocoding & search)
HERE_API_KEY=your_here_api_key_here
HERE_APP_ID=your_here_app_id_here
HERE_GEOCODE_BASE_URL=https://geocode.search.hereapi.com/v1
HERE_REVGEOCODE_BASE_URL=https://revgeocode.search.hereapi.com/v1

# Service area. Morocco is always allowed; add alpha-3 codes only for testing in other countries.
ALLOWED_COUNTRIES=MAR

# KYC (Didit)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Optional allow-list of ID-document countries (alpha-3, comma separated). Empty = any.
KYC_ALLOWED_COUNTRIES=
